{
  "name": "@realstamp/verify",
  "version": "0.1.1",
  "description": "Official SDK for verifying RealStamp credentials, querying revocations and impersonation claims, and subscribing to webhook events.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.mjs",
      "require": "./dist/webhooks.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "realstamp",
    "verification",
    "content-credentials",
    "sd-jwt",
    "sigstore",
    "rekor",
    "c2pa",
    "provenance",
    "deepfake",
    "ai-content",
    "authorship",
    "revocation",
    "impersonation",
    "webhook",
    "trust-layer"
  ],
  "homepage": "https://realstamp.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emiliacarp/realstamp-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/emiliacarp/realstamp-sdk/issues"
  },
  "author": {
    "name": "Skillecta Inc.",
    "url": "https://realstamp.app"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no linter configured yet\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
